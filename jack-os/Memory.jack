/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    static int freeList;

    /** Initializes the class. */
    function void init() {
        var Array ram;

        let ram = 0;
        let freeList = 2048;
        let ram[freeList] = 0;
        let ram[freeList + 1] = 14334;
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        var Array ram;

        let ram = 0;
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        var Array ram;

        let ram = 0;
        let ram[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function Array alloc(int size) {
        var int prev, curr, next, sizeCurr, remaining, newFree;
        var Array ram;

        let ram = 0;
        let prev = 0;
        let curr = freeList;

        while (~(curr = 0)) {
            let sizeCurr = ram[curr + 1];
            if ((sizeCurr > size) | (sizeCurr = size)) {
                let remaining = sizeCurr - size;

                if (remaining > 2) {
                    let newFree = curr + size + 2;
                    let ram[newFree] = ram[curr];
                    let ram[newFree + 1] = sizeCurr - size - 2;

                    if (prev = 0) {
                        let freeList = newFree;
                    }
                    else {
                        let ram[prev] = newFree;
                    }

                    let ram[curr] = 0;
                    let ram[curr + 1] = size;
                }
                else {
                    let next = ram[curr];
                    if (prev = 0) {
                        let freeList = next;
                    }
                    else {
                        let ram[prev] = next;
                    }
                }

                return curr + 2;
            }

            let prev = curr;
            let curr = ram[curr];
        }

        do Sys.error(1);
        return 0;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int block, prev, curr, next, sizePrev, sizeBlock;
        var Array ram;

        let ram = 0;
        let block = o - 2;

        let prev = 0;
        let curr = freeList;
        while ((~(curr = 0)) & (curr < block)) {
            let prev = curr;
            let curr = ram[curr];
        }

        let ram[block] = curr;
        if (prev = 0) {
            let freeList = block;
        }
        else {
            let ram[prev] = block;
        }

        let next = ram[block];
        if (~(next = 0)) {
            let sizeBlock = ram[block + 1];
            if ((block + sizeBlock + 2) = next) {
                let ram[block + 1] = sizeBlock + ram[next + 1] + 2;
                let ram[block] = ram[next];
            }
        }

        if (~(prev = 0)) {
            let sizePrev = ram[prev + 1];
            if ((prev + sizePrev + 2) = block) {
                let ram[prev + 1] = sizePrev + ram[block + 1] + 2;
                let ram[prev] = ram[block];
            }
        }

        return;
    }    
}
